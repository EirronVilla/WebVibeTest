@page
@model WebVibeTest.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Enter the Hall";
}

<div class="row justify-content-center py-4">
    <div class="col-md-6 col-lg-5">
        <section class="medieval-panel p-4">
            <p class="medieval-eyebrow mb-1">Welcome, traveler</p>
            <h1 class="medieval-heading mb-4">Enter the Hall</h1>
            <form method="post" asp-route-returnUrl="@Model.ReturnUrl">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Username" class="form-control" autocomplete="username" autofocus />
                    <label asp-for="Input.Username"></label>
                    <span asp-validation-for="Input.Username" class="text-danger"></span>
                </div>
                <div class="form-floating mb-3">
                    <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
                    <label asp-for="Input.Password"></label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>
                <div class="form-check mb-3">
                    <input asp-for="Input.RememberMe" class="form-check-input" />
                    <label asp-for="Input.RememberMe" class="form-check-label"></label>
                </div>
                <button type="submit" class="btn btn-medieval w-100">Log in</button>
            </form>
            <p class="mt-3 mb-0">New to the realm? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a>.</p>
        </section>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
