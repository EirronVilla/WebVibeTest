@model WebVibeTest.Models.Games.CreateGameViewModel
@{
    ViewData["Title"] = "Create game";
}

<h1>Create game</h1>

<form asp-action="Create" method="post" class="mt-3" style="max-width: 32rem">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="MaxPlayers" class="form-label"></label>
        <select asp-for="MaxPlayers" class="form-select">
            <option value="3">3</option>
            <option value="4">4</option>
            <option value="5">5</option>
            <option value="6">6</option>
        </select>
        <span asp-validation-for="MaxPlayers" class="text-danger"></span>
    </div>
    <div class="form-check mb-3">
        <input asp-for="IsPrivate" class="form-check-input" />
        <label asp-for="IsPrivate" class="form-check-label"></label>
    </div>
    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-link">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
