@model WebVibeTest.Models.Games.LobbyViewModel
@{
    ViewData["Title"] = "Waiting lobby";
}

<div class="medieval-panel d-flex justify-content-between align-items-start mb-4 p-4">
    <div>
        <h1>@Model.Name</h1>
        <p class="mb-1"><strong>Host:</strong> @Model.HostName</p>
        <p><strong>Players:</strong> @Model.Players.Count / @Model.MaxPlayers</p>
    </div>
    @if (Model.IsCurrentUserHost)
    {
        <span class="badge bg-primary">You are the host</span>
    }
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

@if (Model.IsPrivate && Model.IsCurrentUserHost)
{
    <div class="alert alert-info">
        Private join code: <strong class="font-monospace">@Model.JoinCode</strong>
    </div>
}

<h2 class="h4 medieval-heading">Joined players</h2>
<ul class="list-group medieval-list mb-4">
    @foreach (var player in Model.Players)
    {
        <li class="list-group-item d-flex justify-content-between align-items-center">
            <span>
                @player.DisplayName
                @if (player.IsCurrentUser)
                {
                    <span>(you)</span>
                }
                @if (player.IsHost)
                {
                    <span class="badge bg-secondary ms-1">Host</span>
                }
            </span>
            @if (player.IsCurrentUser)
            {
                <form asp-action="SelectColor" asp-route-id="@Model.Id" method="post" class="d-flex align-items-center gap-2">
                    <label for="player-color" class="visually-hidden">Player color</label>
                    <select id="player-color" name="color" class="form-select form-select-sm player-color-select" onchange="this.form.requestSubmit()">
                        @foreach (var color in Enum.GetValues<WebVibeTest.Domain.Games.PlayerColor>())
                        {
                            <option value="@color" selected="@(color == player.Color)">@color</option>
                        }
                    </select>
                    <noscript><button class="btn btn-sm btn-outline-primary" type="submit">Choose</button></noscript>
                </form>
            }
            else
            {
                <span class="player-color-badge player-color-@player.Color.ToString().ToLowerInvariant()">@player.Color</span>
            }
        </li>
    }
</ul>

<p class="text-muted">Waiting for the host to start the game.</p>

@if (Model.IsCurrentUserHost)
{
    <form asp-action="Start" asp-route-id="@Model.Id" method="post" class="mb-3">
        @if (Model.CanStart)
        {
            <button type="submit" class="btn btn-success">Start game</button>
        }
        else
        {
            <button type="button" class="btn btn-success" disabled>Start game</button>
            @if (Model.Players.Count < 3)
            {
                <span class="text-muted ms-2">At least 3 players are required.</span>
            }
            else if (!Model.ColorsAreUnique)
            {
                <span class="text-danger ms-2">Every player must choose a different color.</span>
            }
        }
    </form>
}

<form asp-action="Leave" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-outline-danger">Leave lobby</button>
</form>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@10.0.0/dist/browser/signalr.min.js"></script>
    <script>
        (() => {
            const gameId = "@Model.Id";
            let isSubmitting = false;
            document.querySelectorAll("main form").forEach(form => {
                form.addEventListener("submit", () => { isSubmitting = true; });
            });
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/gameHub")
                .withAutomaticReconnect()
                .build();

            connection.on("LobbyUpdated", updatedGameId => {
                if (!isSubmitting && updatedGameId.toLowerCase() === gameId.toLowerCase()) {
                    window.location.reload();
                }
            });

            connection.on("GameStarted", startedGameId => {
                if (!isSubmitting && startedGameId.toLowerCase() === gameId.toLowerCase()) {
                    window.location.href = `/Games/Play/${gameId}`;
                }
            });

            connection.onreconnected(() => connection.invoke("JoinLobby", gameId));

            const connect = async () => {
                try {
                    await connection.start();
                    await connection.invoke("JoinLobby", gameId);
                } catch {
                    window.setTimeout(connect, 3000);
                }
            };

            connect();
        })();
    </script>
}
