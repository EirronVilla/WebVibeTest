@model WebVibeTest.Models.Games.GamesIndexViewModel
@{
    ViewData["Title"] = "Games";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Available games</h1>
    <a class="btn btn-primary" asp-action="Create">Create game</a>
</div>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<div class="card mb-4">
    <div class="card-body">
        <h2 class="h5">Join a private game</h2>
        <form asp-action="JoinPrivate" method="post" class="row g-2">
            <div class="col-sm-8">
                <label asp-for="PrivateJoin.JoinCode" class="visually-hidden"></label>
                <input name="JoinCode" class="form-control text-uppercase" maxlength="12" placeholder="12-character join code" required />
            </div>
            <div class="col-sm-4">
                <button type="submit" class="btn btn-secondary w-100">Join private game</button>
            </div>
        </form>
    </div>
</div>

@if (Model.Games.Count == 0)
{
    <p>No public games are currently available.</p>
}
else
{
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Game</th>
                    <th>Host</th>
                    <th>Players</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var game in Model.Games)
                {
                    <tr>
                        <td>@game.Name</td>
                        <td>@game.HostName</td>
                        <td>@game.PlayerCount / @game.MaxPlayers</td>
                        <td class="text-end">
                            @if (game.IsMember)
                            {
                                <a class="btn btn-outline-primary btn-sm" asp-action="Lobby" asp-route-id="@game.Id">View lobby</a>
                            }
                            else
                            {
                                <form asp-action="JoinPublic" asp-route-id="@game.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-primary btn-sm">Join</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
