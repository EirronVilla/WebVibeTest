@using System.Globalization
@using WebVibeTest.Domain.Board
@using WebVibeTest.Domain.Games
@using WebVibeTest.Models.Games
@model WebVibeTest.Application.Games.ActiveGameReadModel
@functions {
    private static string F(double value) => value.ToString("0.######", CultureInfo.InvariantCulture);
    private static string BundleText(WebVibeTest.Application.Games.ResourceBundle bundle)
    {
        var parts = new List<string>();
        if (bundle.Brick > 0) parts.Add($"{bundle.Brick} Brick");
        if (bundle.Lumber > 0) parts.Add($"{bundle.Lumber} Lumber");
        if (bundle.Wool > 0) parts.Add($"{bundle.Wool} Wool");
        if (bundle.Grain > 0) parts.Add($"{bundle.Grain} Grain");
        if (bundle.Ore > 0) parts.Add($"{bundle.Ore} Ore");
        return string.Join(", ", parts);
    }
}
@{
    ViewData["Title"] = Model.Name;
    var board = Model.Board;
    var minX = board.Vertices.Min(vertex => vertex.X) - 1;
    var maxX = board.Vertices.Max(vertex => vertex.X) + 1;
    var minY = board.Vertices.Min(vertex => vertex.Y) - 1;
    var maxY = board.Vertices.Max(vertex => vertex.Y) + 1;
    var viewBox = $"{F(minX)} {F(minY)} {F(maxX - minX)} {F(maxY - minY)}";
    var currentPlayerShortName = Model.CurrentPlayerName.Split('@')[0];
}

<h1>@Model.Name</h1>
<p><strong>Phase:</strong> @Model.Phase &middot; <strong>Current player:</strong> @currentPlayerShortName</p>

<section class="renaissance-panel player-roster mb-3" aria-label="Players">
    <div class="player-roster-grid">
        @for (var playerIndex = 0; playerIndex < Model.Players.Count; playerIndex++)
        {
            var player = Model.Players[playerIndex];
            var shortName = player.DisplayName.Split('@')[0];
            <button type="button" class="player-mini player-color-@player.Color.ToString().ToLowerInvariant() @(player.IsCurrentPlayer ? "active-turn" : null)" data-bs-toggle="modal" data-bs-target="#player-modal-@playerIndex">
                <span class="profile-placeholder" aria-hidden="true">♙</span>
                <span class="player-mini-name">@shortName</span>
                <span class="vp-seal">@player.VisibleVictoryPoints VP</span>
            </button>
            <div class="modal fade renaissance-modal" id="player-modal-@playerIndex" tabindex="-1" aria-labelledby="player-modal-title-@playerIndex" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
                    <div class="modal-header"><h2 class="modal-title fs-5" id="player-modal-title-@playerIndex">@shortName</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
                    <div class="modal-body text-center">
                        <div class="profile-placeholder profile-placeholder-large mx-auto">♙</div>
                        <div class="vp-seal d-inline-block my-3">@player.VisibleVictoryPoints victory points</div>
                        <p class="mb-1"><strong>Resource cards:</strong> @player.TotalResources</p>
                        <p><strong>Development cards:</strong> @player.DevelopmentCardCount</p>
                        <small class="text-muted">Other players' card identities remain private.</small>
                    </div>
                </div></div>
            </div>
        }
    </div>
</section>

<section class="action-ribbon mb-3">
    <div class="action-ribbon-left">
        <button class="btn renaissance-button" data-bs-toggle="modal" data-bs-target="#build-modal" @(Model.IsCurrentPlayer && Model.Phase == GamePhase.TurnActions ? null : "disabled")>Build</button>
        <button class="btn renaissance-button" data-bs-toggle="modal" data-bs-target="#player-trade-modal" @(Model.IsCurrentPlayer && Model.Phase == GamePhase.TurnActions ? null : "disabled")>Trade with players</button>
        <button class="btn renaissance-button" data-bs-toggle="modal" data-bs-target="#maritime-trade-modal" @(Model.IsCurrentPlayer && Model.Phase == GamePhase.TurnActions ? null : "disabled")>Maritime Trade</button>
    </div>
    <div class="action-ribbon-right">
        @if (Model.LatestDie1 is int die1 && Model.LatestDie2 is int die2)
        {
            <span class="dice-label">Latest</span><span class="die-face">@die1</span><span class="die-face">@die2</span><strong>= @(die1 + die2)</strong>
        }
        @if (Model.IsCurrentPlayer && Model.Phase == GamePhase.TurnProduction)
        {
            <button type="button" id="roll-dice" class="btn btn-primary">Roll dice</button>
        }
        @if (Model.IsCurrentPlayer && Model.Phase == GamePhase.TurnActions)
        {
            <button type="button" id="end-turn" class="btn btn-danger">End turn</button>
        }
    </div>
</section>

@if (Model.RequiredDiscardCount > 0)
{
    <div class="card border-warning mb-3"><div class="card-body">
        <h2 class="h5">Discard exactly @Model.RequiredDiscardCount cards</h2>
        <div class="resource-hand" id="discard-inputs">
            @foreach (var resource in Enum.GetValues<ResourceType>())
            {
                <label class="resource-card discard-card">
                    <img src="@Url.Content(ResourceCardImageMap.GetPath(resource))" alt="@resource resource card" />
                    <span class="resource-name">@resource</span>
                    <span class="small text-muted">You have @Model.OwnResources.Get(resource)</span>
                    <input class="form-control form-control-sm" type="number" min="0" max="@Model.OwnResources.Get(resource)" value="0" name="@resource.ToString().ToLowerInvariant()" aria-label="Number of @resource cards to discard" />
                </label>
            }
        </div>
        <button type="button" id="discard-resources" class="btn btn-warning mt-2">Discard</button>
    </div></div>
}

@if (Model.IsCurrentPlayer && Model.Phase == WebVibeTest.Domain.Games.GamePhase.AwaitingRobberPlacement)
{
    <div class="alert alert-warning">Select a different terrain hex to move the robber.</div>
}

@if (Model.IsCurrentPlayer && Model.Phase == WebVibeTest.Domain.Games.GamePhase.AwaitingRobberyTarget)
{
    <div class="card border-danger mb-3"><div class="card-body">
        <h2 class="h5">Choose a player to rob</h2>
        @foreach (var target in Model.EligibleRobberyTargets)
        {
            <button type="button" class="btn btn-outline-danger robbery-target" data-target-user-id="@target.UserId">@target.DisplayName</button>
        }
    </div></div>
}

@if (Model.IsCurrentPlayer && Model.Phase == WebVibeTest.Domain.Games.GamePhase.TurnActions)
{
    <div class="modal fade renaissance-modal" id="build-modal" tabindex="-1" aria-labelledby="build-modal-title" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h2 class="modal-title fs-5" id="build-modal-title">Commission construction</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
        <div class="d-flex flex-wrap gap-2">
            @if (Model.Construction.CanAffordRoad && Model.Construction.RoadsRemaining > 0 && Model.Construction.ValidRoadEdgeIds.Count > 0)
            {
                <button type="button" class="btn btn-outline-primary build-mode" data-bs-dismiss="modal" data-build-mode="road">Road <small>(1 Brick, 1 Lumber)</small></button>
            }
            else
            {
                <button type="button" class="btn btn-outline-secondary" disabled>Road <small>(1 Brick, 1 Lumber)</small></button>
            }
            @if (Model.Construction.CanAffordSettlement && Model.Construction.SettlementsRemaining > 0 && Model.Construction.ValidSettlementVertexIds.Count > 0)
            {
                <button type="button" class="btn btn-outline-primary build-mode" data-bs-dismiss="modal" data-build-mode="settlement">Settlement <small>(Brick, Lumber, Wool, Grain)</small></button>
            }
            else
            {
                <button type="button" class="btn btn-outline-secondary" disabled>Settlement <small>(Brick, Lumber, Wool, Grain)</small></button>
            }
            @if (Model.Construction.CanAffordCity && Model.Construction.CitiesRemaining > 0 && Model.Construction.ValidCityVertexIds.Count > 0)
            {
                <button type="button" class="btn btn-outline-primary build-mode" data-bs-dismiss="modal" data-build-mode="city">City <small>(3 Ore, 2 Grain)</small></button>
            }
            else
            {
                <button type="button" class="btn btn-outline-secondary" disabled>City <small>(3 Ore, 2 Grain)</small></button>
            }
        </div>
        <div class="small text-muted mt-2">
            Pieces remaining: @Model.Construction.RoadsRemaining roads, @Model.Construction.SettlementsRemaining settlements, @Model.Construction.CitiesRemaining cities.
        </div>
        </div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Close</button></div>
    </div></div></div>

    <div class="modal fade renaissance-modal" id="player-trade-modal" tabindex="-1" aria-labelledby="player-trade-title" aria-hidden="true"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h2 class="modal-title fs-5" id="player-trade-title">Negotiate with players</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
        <div class="row g-3" id="trade-proposal">
            <div class="col-md-6">
                <strong>Offer</strong>
                <div class="row g-1">
                    @foreach (var resource in Enum.GetValues<ResourceType>())
                    {
                        <div class="col"><label class="small">@resource</label><input type="number" min="0" value="0" class="form-control form-control-sm" name="offered@resource" /></div>
                    }
                </div>
            </div>
            <div class="col-md-6">
                <strong>Request</strong>
                <div class="row g-1">
                    @foreach (var resource in Enum.GetValues<ResourceType>())
                    {
                        <div class="col"><label class="small">@resource</label><input type="number" min="0" value="0" class="form-control form-control-sm" name="requested@resource" /></div>
                    }
                </div>
            </div>
        </div>
        </div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" id="propose-trade" class="btn btn-success">Propose to all players</button></div>
    </div></div></div>

    <div class="modal fade renaissance-modal" id="maritime-trade-modal" tabindex="-1" aria-labelledby="maritime-trade-title" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h2 class="modal-title fs-5" id="maritime-trade-title">Trade across the sea</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
        <div class="d-flex flex-wrap gap-2 align-items-end">
            <div><label class="form-label">Give</label><select id="maritime-give" class="form-select">
                @foreach (var resource in Enum.GetValues<ResourceType>())
                {
                    <option value="@resource">@resource (@Model.Trading.MaritimeRates[resource]:1)</option>
                }
            </select></div>
            <div><label class="form-label">Receive</label><select id="maritime-receive" class="form-select">
                @foreach (var resource in Enum.GetValues<ResourceType>()) { <option value="@resource">@resource</option> }
            </select></div>
        </div>
        </div><div class="modal-footer"><button class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button type="button" id="maritime-trade" class="btn btn-info">Trade with bank</button></div>
    </div></div></div>
}

@if (Model.IsCurrentPlayer && Model.Phase == GamePhase.AwaitingRoadBuilding)
{
    <div class="alert alert-warning">Place up to @Model.DevelopmentCards.FreeRoadsRemaining free roads. <button type="button" id="finish-road-building" class="btn btn-sm btn-outline-dark">Finish</button></div>
}

@if (Model.Trading.Offers.Count > 0)
{
    <div class="card mb-3"><div class="card-body">
        <h2 class="h5">Open trade offers</h2>
        @foreach (var offer in Model.Trading.Offers)
        {
            <div class="border rounded p-2 mb-2">
                <strong>@offer.ProposerName offers:</strong> @BundleText(offer.Offered)<br />
                <strong>For:</strong> @BundleText(offer.Requested)
                @if (offer.IsProposer)
                {
                    <div class="mt-2">
                        @foreach (var response in offer.Responses)
                        {
                            <span class="me-2">@response.DisplayName: @response.Status</span>
                            @if (response.Status == TradeResponseStatus.Accepted)
                            {
                                <button type="button" class="btn btn-sm btn-success finalize-trade" data-offer-id="@offer.Id" data-accepting-user-id="@response.UserId">Finalize</button>
                            }
                        }
                        <button type="button" class="btn btn-sm btn-outline-danger cancel-trade" data-offer-id="@offer.Id">Cancel</button>
                    </div>
                }
                else
                {
                    <div class="mt-2">
                        <span class="me-2">Your response: @offer.OwnResponse</span>
                        <button type="button" class="btn btn-sm btn-success respond-trade" data-offer-id="@offer.Id" data-accept="true">Accept</button>
                        <button type="button" class="btn btn-sm btn-outline-danger respond-trade" data-offer-id="@offer.Id" data-accept="false">Reject</button>
                    </div>
                }
            </div>
        }
    </div></div>
}

@if (Model.IsCurrentPlayer && Model.Phase is WebVibeTest.Domain.Games.GamePhase.InitialPlacementForward or WebVibeTest.Domain.Games.GamePhase.InitialPlacementReverse)
{
    <div class="alert alert-info">
        Your turn: place a @(Model.MustPlaceSettlement ? "settlement" : "road connected to your new settlement").
    </div>
}
else if (Model.Phase == WebVibeTest.Domain.Games.GamePhase.TurnProduction)
{
    <div class="alert alert-success">Production phase: the active player must roll the dice.</div>
}

<div id="placement-error" class="alert alert-danger d-none" role="alert"></div>
<form id="anti-forgery" class="d-none">@Html.AntiForgeryToken()</form>

<div class="modal fade" id="placement-confirmation-modal" tabindex="-1" aria-labelledby="placement-confirmation-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="placement-confirmation-title">Confirm placement</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Place this <strong id="placement-piece-name">piece</strong> at the selected location?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="confirm-placement">Place piece</button>
            </div>
        </div>
    </div>
</div>

<h2 class="board-heading">The Settlers' Map</h2>
<svg viewBox="@viewBox" style="width:100%; max-height:75vh; background:#b7dceb" aria-label="CATAN board">
    <defs>
        @foreach (var hex in board.Hexes)
        {
            var clipPoints = string.Join(" ", hex.VertexIds.Select(vertexId => $"{F(board.Vertices[vertexId].X)},{F(board.Vertices[vertexId].Y)}"));
            <clipPath id="hex-clip-@hex.Id">
                <polygon points="@clipPoints" />
            </clipPath>
        }
    </defs>

    <g id="terrain-tiles">
        @foreach (var hex in board.Hexes)
        {
            var points = string.Join(" ", hex.VertexIds.Select(vertexId => $"{F(board.Vertices[vertexId].X)},{F(board.Vertices[vertexId].Y)}"));
            var tileVertices = hex.VertexIds.Select(vertexId => board.Vertices[vertexId]).ToList();
            var tileMinX = tileVertices.Min(vertex => vertex.X);
            var tileMaxX = tileVertices.Max(vertex => vertex.X);
            var tileMinY = tileVertices.Min(vertex => vertex.Y);
            var tileMaxY = tileVertices.Max(vertex => vertex.Y);
            var tileCenterX = (tileMinX + tileMaxX) / 2;
            var tileCenterY = (tileMinY + tileMaxY) / 2;
            var imagePath = Url.Content(TerrainImageMap.GetPath(hex.Terrain));
            <g clip-path="url(#hex-clip-@hex.Id)">
                <image href="@imagePath"
                       x="@F(tileMinX)"
                       y="@F(tileMinY)"
                       width="@F(tileMaxX - tileMinX)"
                       height="@F(tileMaxY - tileMinY)"
                       preserveAspectRatio="xMidYMid slice"
                       transform="rotate(30 @F(tileCenterX) @F(tileCenterY))" />
            </g>
            <polygon points="@points" fill="none" stroke="#f3e6bd" stroke-width="0.08" />
            @if (Model.IsCurrentPlayer && Model.Phase == WebVibeTest.Domain.Games.GamePhase.AwaitingRobberPlacement && hex.Id != board.RobberHexId)
            {
                <polygon class="placement-location" data-robber-hex-id="@hex.Id" points="@points" fill="#ffc107" fill-opacity="0.22" stroke="#ffc107" stroke-width="0.08" />
            }
        }
    </g>

    <g id="number-tokens-and-robber" pointer-events="none">
    @foreach (var hex in board.Hexes)
    {
        var centerX = hex.VertexIds.Average(vertexId => board.Vertices[vertexId].X);
        var centerY = hex.VertexIds.Average(vertexId => board.Vertices[vertexId].Y);
        @if (hex.NumberToken is int token)
        {
            <circle cx="@F(centerX)" cy="@F(centerY)" r="0.28" fill="#f4e8c1" stroke="#5f4b32" stroke-width="0.03" />
            <text><tspan x="@F(centerX)" y="@F(centerY + 0.1)" text-anchor="middle" font-size="0.3" font-weight="bold" fill="@(token is 6 or 8 ? "#b00020" : "#222")">@token</tspan></text>
        }
        @if (hex.Id == board.RobberHexId)
        {
            var robberWidth = 0.72;
            var robberHeight = 0.72;
            <image href="@Url.Content(BoardPieceAssetMap.RobberPath)"
                   x="@F(centerX - robberWidth / 2)"
                   y="@F(centerY - robberHeight * 0.72)"
                   width="@F(robberWidth)"
                   height="@F(robberHeight)"
                   preserveAspectRatio="xMidYMid meet"
                   pointer-events="none" />
        }
    }
    </g>

    @foreach (var edge in board.Edges)
    {
        var a = board.Vertices[edge.VertexAId];
        var b = board.Vertices[edge.VertexBId];
        <line x1="@F(a.X)" y1="@F(a.Y)" x2="@F(b.X)" y2="@F(b.Y)" stroke="#6b573f" stroke-width="0.045" />
        @if (edge.Road is not null)
        {
            <line x1="@F(a.X)" y1="@F(a.Y)" x2="@F(b.X)" y2="@F(b.Y)" stroke="@edge.Road.Color.ToString().ToLowerInvariant()" stroke-width="0.14" stroke-linecap="round" />
        }
        else if (Model.ValidRoadEdgeIds.Contains(edge.Id))
        {
            <line class="placement-location" data-edge-id="@edge.Id" x1="@F(a.X)" y1="@F(a.Y)" x2="@F(b.X)" y2="@F(b.Y)" stroke="#00a6ff" stroke-width="0.18" stroke-linecap="round" opacity="0.7" />
        }
        @if (Model.Construction.ValidRoadEdgeIds.Contains(edge.Id))
        {
            <line class="placement-location normal-build-location build-road-location d-none" data-build-road-edge-id="@edge.Id" x1="@F(a.X)" y1="@F(a.Y)" x2="@F(b.X)" y2="@F(b.Y)" stroke="#ffd43b" stroke-width="0.2" stroke-linecap="round" opacity="0.85" />
        }
        @if (Model.DevelopmentCards.ValidFreeRoadEdgeIds.Contains(edge.Id))
        {
            <line class="placement-location" data-free-road-edge-id="@edge.Id" x1="@F(a.X)" y1="@F(a.Y)" x2="@F(b.X)" y2="@F(b.Y)" stroke="#ff9f1c" stroke-width="0.2" stroke-linecap="round" opacity="0.9" />
        }
    }

    @foreach (var port in board.Ports)
    {
        var edge = board.Edges[port.EdgeId];
        var x = (board.Vertices[edge.VertexAId].X + board.Vertices[edge.VertexBId].X) / 2;
        var y = (board.Vertices[edge.VertexAId].Y + board.Vertices[edge.VertexBId].Y) / 2;
        <text><tspan x="@F(x)" y="@F(y + 0.08)" text-anchor="middle" font-size="0.18" font-weight="bold" fill="#242424">@port.Type</tspan></text>
    }

    @foreach (var vertex in board.Vertices)
    {
        @if (vertex.Settlement is not null)
        {
            var buildingAsset = BoardPieceAssetMap.GetBuildingPath(vertex.Settlement.Color, vertex.Settlement.BuildingType);
            <circle cx="@F(vertex.X)" cy="@F(vertex.Y)" r="0.17" fill="@vertex.Settlement.Color.ToString().ToLowerInvariant()" stroke="#222" stroke-width="0.04" />
            @if (buildingAsset is not null)
            {
                var buildingSize = vertex.Settlement.BuildingType == BuildingType.City ? 0.9 : 0.72;
                <image href="@Url.Content(buildingAsset)"
                       x="@F(vertex.X - buildingSize / 2)"
                       y="@F(vertex.Y - buildingSize * 0.82)"
                       width="@F(buildingSize)"
                       height="@F(buildingSize)"
                       preserveAspectRatio="xMidYMid meet"
                       pointer-events="none" />
            }
            @if (Model.Construction.ValidCityVertexIds.Contains(vertex.Id))
            {
                <circle class="placement-location normal-build-location build-city-location d-none" data-build-city-vertex-id="@vertex.Id" cx="@F(vertex.X)" cy="@F(vertex.Y)" r="0.24" fill="#ffd43b" fill-opacity="0.35" stroke="#ffd43b" stroke-width="0.055" />
            }
        }
        else if (Model.AvailableConstructionVertexIds.Contains(vertex.Id))
        {
            @if (Model.ValidSettlementVertexIds.Contains(vertex.Id))
            {
                <g class="placement-location available-vertex">
                    <circle cx="@F(vertex.X)" cy="@F(vertex.Y)" r="0.13" fill="none" stroke="#111" stroke-width="0.045" pointer-events="none" />
                    <circle class="vertex-hit-target" data-vertex-id="@vertex.Id" cx="@F(vertex.X)" cy="@F(vertex.Y)" r="0.28" fill="#fff" fill-opacity="0.001" stroke="none" pointer-events="all" />
                </g>
            }
            else
            {
                <circle class="available-vertex" cx="@F(vertex.X)" cy="@F(vertex.Y)" r="0.13" fill="none" stroke="#111" stroke-width="0.045" pointer-events="none" />
            }
            @if (Model.Construction.ValidSettlementVertexIds.Contains(vertex.Id))
            {
                <circle class="placement-location normal-build-location build-settlement-location d-none" data-build-settlement-vertex-id="@vertex.Id" cx="@F(vertex.X)" cy="@F(vertex.Y)" r="0.19" fill="#ffd43b" fill-opacity="0.3" stroke="#ffd43b" stroke-width="0.055" />
            }
        }
        else
        {
            var markerRadius = 0.13;
            var crossOffset = 0.075;
            <g class="blocked-vertex" pointer-events="none">
                <circle cx="@F(vertex.X)" cy="@F(vertex.Y)" r="@F(markerRadius)" fill="none" stroke="#6c1b1b" stroke-width="0.045" />
                <line x1="@F(vertex.X - crossOffset)" y1="@F(vertex.Y - crossOffset)" x2="@F(vertex.X + crossOffset)" y2="@F(vertex.Y + crossOffset)" stroke="#6c1b1b" stroke-width="0.04" stroke-linecap="round" />
                <line x1="@F(vertex.X - crossOffset)" y1="@F(vertex.Y + crossOffset)" x2="@F(vertex.X + crossOffset)" y2="@F(vertex.Y - crossOffset)" stroke="#6c1b1b" stroke-width="0.04" stroke-linecap="round" />
            </g>
        }
    }
</svg>

<section class="renaissance-panel player-hand-section mt-3">
    <div class="hand-column">
        <h2 class="h5">Your resources (@Model.OwnResources.Total)</h2>
        <div class="resource-hand">
            @foreach (var resource in Enum.GetValues<ResourceType>())
            {
                <div class="resource-card" title="@resource: @Model.OwnResources.Get(resource)">
                    <div class="resource-card-art"><img src="@Url.Content(ResourceCardImageMap.GetPath(resource))" alt="@resource resource card" /><span class="resource-count">@Model.OwnResources.Get(resource)</span></div>
                    <span class="resource-name">@resource</span>
                </div>
            }
        </div>
    </div>
    <button type="button" class="development-stack" data-bs-toggle="modal" data-bs-target="#development-cards-modal">
        <img src="~/img/cards/development_card.png" alt="Open your development cards" />
        <span><strong>@Model.DevelopmentCards.OwnCards.Count</strong> development cards</span>
        <small>@Model.DevelopmentCards.DeckRemaining remain in the deck</small>
    </button>
</section>

<div class="modal fade renaissance-modal" id="development-cards-modal" tabindex="-1" aria-labelledby="development-cards-title" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h2 class="modal-title fs-5" id="development-cards-title">Your council of development</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
        <div class="modal-body">
            <p>Actual victory points: <strong>@Model.DevelopmentCards.ActualVictoryPoints</strong> &middot; Knights played: @Model.DevelopmentCards.KnightsPlayed</p>
            <div class="d-flex flex-wrap gap-3">
                @foreach (var card in Model.DevelopmentCards.OwnCards)
                {
                    <div class="development-card text-center" data-card-id="@card.Id">
                        <img src="~/img/cards/development_card.png" alt="Development card" />
                        <strong class="d-block">@card.Type</strong>
                        @if (card.IsNew) { <small class="text-muted d-block">Playable next turn</small> }
                        @if (card.CanPlay)
                        {
                            if (card.Type == DevelopmentCardType.YearOfPlenty)
                            {
                                <select class="form-select form-select-sm dev-first">@foreach (var resource in Enum.GetValues<ResourceType>()) { <option>@resource</option> }</select>
                                <select class="form-select form-select-sm dev-second">@foreach (var resource in Enum.GetValues<ResourceType>()) { <option>@resource</option> }</select>
                            }
                            else if (card.Type == DevelopmentCardType.Monopoly)
                            {
                                <select class="form-select form-select-sm dev-resource">@foreach (var resource in Enum.GetValues<ResourceType>()) { <option>@resource</option> }</select>
                            }
                            <button type="button" class="btn btn-sm btn-warning mt-1 play-development" data-card-type="@card.Type">Use card</button>
                        }
                    </div>
                }
                @if (Model.DevelopmentCards.OwnCards.Count == 0) { <span class="text-muted">You have no development cards.</span> }
            </div>
        </div>
        <div class="modal-footer">
            @if (Model.DevelopmentCards.CanBuy) { <button type="button" id="buy-development" class="btn btn-warning">Buy card <small>(Ore, Wool, Grain)</small></button> }
            <button class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
        </div>
    </div></div>
</div>

<style>
