@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@10.0.0/dist/browser/signalr.min.js"></script>
    <script>
        (() => {
            const gameId = "@Model.Id";
            const currentUserId = "@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value";
            const ownResources = { Brick: @Model.OwnResources.Brick, Lumber: @Model.OwnResources.Lumber, Wool: @Model.OwnResources.Wool, Grain: @Model.OwnResources.Grain, Ore: @Model.OwnResources.Ore };
            const token = document.querySelector('#anti-forgery input').value;
            const errorBox = document.getElementById('placement-error');
            let submitting = false;
            let refreshing = false;
            let pendingPlacement = null;
            const placementModalElement = document.getElementById('placement-confirmation-modal');
            const placementModal = bootstrap.Modal.getOrCreateInstance(placementModalElement);
            const placementPieceName = document.getElementById('placement-piece-name');
            const incomingTradeModal = bootstrap.Modal.getOrCreateInstance(document.getElementById('incoming-trade-modal'));
            let incomingOfferId = null;
            let readyOfferId = null;
            const tradeText = bundle => Object.entries(bundle).filter(([, amount]) => amount > 0).map(([resource, amount]) => `${amount} ${resource}`).join(', ');
            const canAffordRequested = bundle => Object.entries(bundle).every(([resource, amount]) => ownResources[resource[0].toUpperCase() + resource.slice(1)] >= amount);
            const cardImages = { brick: 'brick_card.png', lumber: 'wood_card.png', wool: 'sheep_card.png', grain: 'wheat_card.png', ore: 'rock_card.png' };
            const renderTradeCards = (elementId, bundle) => {
                const host = document.getElementById(elementId);
                host.innerHTML = Object.entries(bundle).filter(([, amount]) => amount > 0).map(([resource, amount]) => `<div class="trade-card"><img src="/img/cards/${cardImages[resource]}" alt="${resource}" /><span>${amount}</span></div>`).join('');
            };

            const postCommand = async (url, values = {}, commandErrorBox = errorBox) => {
                if (submitting) return false;
                submitting = true;
                try {
                    const body = new URLSearchParams({ id: gameId, ...values, __RequestVerificationToken: token });
                    const response = await fetch(url, { method: 'POST', body });
                    if (response.ok) return true;
                    commandErrorBox.textContent = await response.text();
                    commandErrorBox.classList.remove('d-none');
                    submitting = false;
                    return false;
                } catch {
                    commandErrorBox.textContent = 'The command could not reach the server. Please try again.';
                    commandErrorBox.classList.remove('d-none');
                    submitting = false;
                    return false;
                }
            };

            const confirmPlacement = (piece, action) => {
                pendingPlacement = action;
                placementPieceName.textContent = piece;
                placementModal.show();
            };

            document.getElementById('confirm-placement').addEventListener('click', () => {
                const action = pendingPlacement;
                pendingPlacement = null;
                placementModal.hide();
                action?.();
            });
            placementModalElement.addEventListener('hidden.bs.modal', () => pendingPlacement = null);

            document.querySelectorAll('[data-vertex-id]').forEach(element =>
                element.addEventListener('click', () => confirmPlacement('settlement', () =>
                    postCommand('@Url.Action("PlaceSettlement", "Games")', { vertexId: element.dataset.vertexId }))));
            document.querySelectorAll('[data-edge-id]').forEach(element =>
                element.addEventListener('click', () => confirmPlacement('road', () =>
                    postCommand('@Url.Action("PlaceRoad", "Games")', { edgeId: element.dataset.edgeId }))));
            document.querySelectorAll('[data-robber-hex-id]').forEach(element =>
                element.addEventListener('click', () => postCommand('@Url.Action("MoveRobber", "Games")', { hexId: element.dataset.robberHexId })));
            document.querySelectorAll('[data-target-user-id]').forEach(element =>
                element.addEventListener('click', () => postCommand('@Url.Action("RobPlayer", "Games")', { targetUserId: element.dataset.targetUserId })));
            document.querySelectorAll('[data-build-road-edge-id]').forEach(element =>
                element.addEventListener('click', () => confirmPlacement('road', () =>
                    postCommand('@Url.Action("BuildRoad", "Games")', { edgeId: element.dataset.buildRoadEdgeId }))));
            document.querySelectorAll('[data-build-settlement-vertex-id]').forEach(element =>
                element.addEventListener('click', () => confirmPlacement('settlement', () =>
                    postCommand('@Url.Action("BuildSettlement", "Games")', { vertexId: element.dataset.buildSettlementVertexId }))));
            document.querySelectorAll('[data-build-city-vertex-id]').forEach(element =>
                element.addEventListener('click', () => confirmPlacement('city', () =>
                    postCommand('@Url.Action("BuildCity", "Games")', { vertexId: element.dataset.buildCityVertexId }))));
            document.querySelectorAll('[data-free-road-edge-id]').forEach(element =>
                element.addEventListener('click', () => confirmPlacement('road', () =>
                    postCommand('@Url.Action("BuildFreeRoad", "Games")', { edgeId: element.dataset.freeRoadEdgeId }))));
            document.querySelectorAll('[data-build-mode]').forEach(button => button.addEventListener('click', () => {
                document.querySelectorAll('.normal-build-location').forEach(location => location.classList.add('d-none'));
                document.querySelectorAll('[data-build-mode]').forEach(candidate => candidate.classList.remove('active'));
                document.querySelectorAll(`.build-${button.dataset.buildMode}-location`).forEach(location => location.classList.remove('d-none'));
                button.classList.add('active');
            }));
            const rollDice = () => postCommand('@Url.Action("RollDice", "Games")');
            document.getElementById('roll-dice')?.addEventListener('click', rollDice);
            const yourTurnModalElement = document.getElementById('your-turn-modal');
            if (yourTurnModalElement) {
                const yourTurnModal = bootstrap.Modal.getOrCreateInstance(yourTurnModalElement);
                const promptKey = `catan-your-turn:${gameId}:${currentUserId}:${yourTurnModalElement.dataset.turnNumber}`;
                if (!sessionStorage.getItem(promptKey)) {
                    sessionStorage.setItem(promptKey, 'shown');
                    yourTurnModal.show();
                }
                document.getElementById('your-turn-roll').addEventListener('click', async () => {
                    yourTurnModal.hide();
                    if (!await rollDice()) yourTurnModal.show();
                });
            }
            document.getElementById('end-turn')?.addEventListener('click', () => postCommand('@Url.Action("EndTurn", "Games")'));
            const discardModalElement = document.getElementById('discard-modal');
            if (discardModalElement) {
                const requiredDiscardCount = @Model.RequiredDiscardCount;
                const discardInputs = [...document.querySelectorAll('#discard-inputs input')];
                const discardButton = document.getElementById('discard-resources');
                const discardProgress = document.getElementById('discard-progress');
                const discardError = document.getElementById('discard-modal-error');
                const discardModal = new bootstrap.Modal(discardModalElement, { backdrop: 'static', keyboard: false });
                const updateDiscardSelection = () => {
                    let selected = 0;
                    discardInputs.forEach(input => {
                        const maximum = Number(input.max);
                        const amount = Math.max(0, Math.min(maximum, Number.parseInt(input.value || '0', 10) || 0));
                        if (Number(input.value) !== amount) input.value = amount;
                        selected += amount;
                    });
                    discardProgress.textContent = `Selected ${selected} of ${requiredDiscardCount}`;
                    discardProgress.classList.toggle('is-valid', selected === requiredDiscardCount);
                    discardProgress.classList.toggle('is-over', selected > requiredDiscardCount);
                    discardButton.disabled = selected !== requiredDiscardCount;
                };
                discardInputs.forEach(input => input.addEventListener('input', updateDiscardSelection));
                discardButton.addEventListener('click', async () => {
                    updateDiscardSelection();
                    if (discardButton.disabled) return;
                    discardError.classList.add('d-none');
                    const values = {};
                    discardInputs.forEach(input => values[input.name] = input.value);
                    if (await postCommand('@Url.Action("Discard", "Games")', values, discardError)) discardModal.hide();
                });
                updateDiscardSelection();
                discardModal.show();
            }
            document.getElementById('propose-trade')?.addEventListener('click', () => {
                const values = { offeredBrick: 0, offeredLumber: 0, offeredWool: 0, offeredGrain: 0, offeredOre: 0, requestedBrick: 0, requestedLumber: 0, requestedWool: 0, requestedGrain: 0, requestedOre: 0 };
                document.querySelectorAll('.trade-offered-input').forEach(input => values[`offered${input.dataset.resource}`] = input.value || 0);
                document.querySelectorAll('.trade-requested-input').forEach(input => values[`requested${input.dataset.resource}`] = input.value || 0);
                const offeredTotal = Object.keys(values).filter(key => key.startsWith('offered')).reduce((sum, key) => sum + Number(values[key]), 0);
                const requestedTotal = Object.keys(values).filter(key => key.startsWith('requested')).reduce((sum, key) => sum + Number(values[key]), 0);
                if (offeredTotal < 1 || requestedTotal < 1) {
                    errorBox.textContent = 'Choose at least one resource to offer and one to request.';
                    errorBox.classList.remove('d-none');
                    return;
                }
                postCommand('@Url.Action("ProposeTrade", "Games")', values);
            });
            document.querySelectorAll('.respond-trade').forEach(button => button.addEventListener('click', () =>
                postCommand('@Url.Action("RespondToTrade", "Games")', { offerId: button.dataset.offerId, accept: button.dataset.accept })));
            document.querySelectorAll('.finalize-trade').forEach(button => button.addEventListener('click', () =>
                postCommand('@Url.Action("FinalizeTrade", "Games")', { offerId: button.dataset.offerId, acceptingUserId: button.dataset.acceptingUserId })));
            document.querySelectorAll('.cancel-trade').forEach(button => button.addEventListener('click', () =>
                postCommand('@Url.Action("CancelTrade", "Games")', { offerId: button.dataset.offerId })));
            document.getElementById('maritime-trade')?.addEventListener('click', () =>
                postCommand('@Url.Action("MaritimeTrade", "Games")', {
                    give: document.getElementById('maritime-give').value,
                    receive: document.getElementById('maritime-receive').value
                }));
            document.getElementById('confirm-buy-development')?.addEventListener('click', () => {
                bootstrap.Modal.getOrCreateInstance(document.getElementById('buy-development-modal')).hide();
                postCommand('@Url.Action("BuyDevelopmentCard", "Games")');
            });
            document.getElementById('finish-road-building')?.addEventListener('click', () => postCommand('@Url.Action("FinishRoadBuilding", "Games")'));
            document.querySelectorAll('.play-development').forEach(button => button.addEventListener('click', () => {
                const card = button.closest('[data-card-id]');
                const values = { cardId: card.dataset.cardId };
                let action = `Play${button.dataset.cardType}`;
                if (button.dataset.cardType === 'YearOfPlenty') {
                    values.first = card.querySelector('.dev-first').value;
                    values.second = card.querySelector('.dev-second').value;
                } else if (button.dataset.cardType === 'Monopoly') {
                    values.resource = card.querySelector('.dev-resource').value;
                }
                postCommand(`/Games/${action}`, values);
            }));

            const connection = new signalR.HubConnectionBuilder().withUrl('/gameHub').withAutomaticReconnect().build();
            const actionLogList = document.getElementById('action-log-list');
            const scrollActionLogToEnd = () => { if (actionLogList) actionLogList.scrollTop = actionLogList.scrollHeight; };
            scrollActionLogToEnd();
            connection.on('ActionLogEntryAdded', entry => {
                if (!actionLogList) return;
                const wasNearEnd = actionLogList.scrollHeight - actionLogList.clientHeight - actionLogList.scrollTop < 36;
                if (actionLogList.querySelector(`[data-sequence="${entry.sequence}"]`)) return;
                const item = document.createElement('li');
                item.dataset.sequence = entry.sequence;
                item.textContent = entry.message;
                actionLogList.appendChild(item);
                while (actionLogList.children.length > 150) actionLogList.firstElementChild.remove();
                if (wasNearEnd) scrollActionLogToEnd();
            });
            connection.on('TradeOffered', offer => {
                if (offer.gameId.toLowerCase() !== gameId.toLowerCase() || offer.proposerUserId === currentUserId) return;
                incomingOfferId = offer.offerId;
                document.getElementById('incoming-trade-summary').textContent = `You give: ${tradeText(offer.requested)} · You receive: ${tradeText(offer.offered)}`;
                renderTradeCards('incoming-trade-give', offer.requested);
                renderTradeCards('incoming-trade-receive', offer.offered);
                const eligible = canAffordRequested(offer.requested);
                document.getElementById('incoming-trade-capability').textContent = eligible ? 'You can satisfy this offer.' : 'You do not have the requested resources.';
                document.querySelectorAll('.incoming-trade-response').forEach(button => button.disabled = button.dataset.accept === 'true' && !eligible);
                incomingTradeModal.show();
            });
            connection.on('TradeAllRejected', event => {
                if (event.gameId.toLowerCase() === gameId.toLowerCase()) bootstrap.Modal.getOrCreateInstance(document.getElementById('trade-rejected-modal')).show();
            });
            connection.on('TradeReady', event => {
                if (event.gameId.toLowerCase() !== gameId.toLowerCase()) return;
                readyOfferId = event.offerId;
                const select = document.getElementById('trade-ready-partner');
                select.innerHTML = (event.acceptedUserIds || []).map(id => `<option value="${id}">${event.acceptedNames?.[id] || id}</option>`).join('');
                bootstrap.Modal.getOrCreateInstance(document.getElementById('trade-ready-modal')).show();
            });
            document.getElementById('finalize-ready-trade').addEventListener('click', () => {
                const acceptingUserId = document.getElementById('trade-ready-partner').value;
                bootstrap.Modal.getOrCreateInstance(document.getElementById('trade-ready-modal')).hide();
                postCommand('@Url.Action("FinalizeTrade", "Games")', { offerId: readyOfferId, acceptingUserId });
            });
            document.getElementById('cancel-ready-trade').addEventListener('click', () => {
                bootstrap.Modal.getOrCreateInstance(document.getElementById('trade-ready-modal')).hide();
                postCommand('@Url.Action("CancelTrade", "Games")', { offerId: readyOfferId });
            });
            document.querySelectorAll('.incoming-trade-response').forEach(button => button.addEventListener('click', () => {
                const accept = button.dataset.accept;
                incomingTradeModal.hide();
                postCommand('@Url.Action("RespondToTrade", "Games")', { offerId: incomingOfferId, accept });
            }));
            connection.on('GameStateUpdated', updatedGameId => {
                if (updatedGameId.toLowerCase() !== gameId.toLowerCase() || refreshing) return;
                // Preserve an affected player's in-progress discard selection when
                // another player completes their own discard.
                if (discardModalElement && !submitting) return;
                refreshing = true;
                connection.stop().finally(() => window.location.reload());
            });
            connection.onreconnected(() => connection.invoke('JoinLobby', gameId));
            const connect = async () => {
                try {
                    await connection.start();
                    await connection.invoke('JoinLobby', gameId);
                } catch {
                    window.setTimeout(connect, 3000);
                }
            };
            connect();
        })();
    </script>
}
