    .profile-placeholder {
        display: grid; width: 30px; height: 30px; place-items: center; border: 1px solid #70551e;
        border-radius: 50%; color: #70551e; background: #f7edcf; font-size: 1.2rem;
    }
    .profile-placeholder-large { width: 88px; height: 88px; font-size: 3rem; }
    .vp-seal { padding: .22rem .48rem; border: 2px solid #9a6611; border-radius: 999px; color: #fff9dc; background: #9b1717; font-weight: 800; white-space: nowrap; }
    .action-ribbon { display: flex; justify-content: space-between; align-items: center; gap: 1rem; padding: .7rem; }
    .action-ribbon-left, .action-ribbon-right { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem; }
    .renaissance-button { border: 1px solid #694d18; color: #fff8df; background: linear-gradient(#926a27, #60420f); }
    .renaissance-button:hover { color: white; background: linear-gradient(#a77b31, #755117); }
    .die-face { display: inline-grid; width: 2.35rem; height: 2.35rem; place-items: center; border: 2px solid #654a1c; border-radius: .35rem; background: #fffdf4; font: 700 1.25rem Georgia,serif; }
    .player-hand-section { display: grid; grid-template-columns: 1fr minmax(150px, 210px); gap: 1rem; padding: 1rem; }
    .development-stack { padding: .6rem; border: 1px solid #72551d; border-radius: .5rem; color: #34230e; background: rgba(255,255,255,.42); }
    .development-stack img { display: block; width: 85px; height: 115px; margin: 0 auto .4rem; object-fit: contain; }
    .development-stack span, .development-stack small { display: block; }
    .renaissance-modal .modal-content { border: 2px solid #765719; background: #fff9e9; box-shadow: inset 0 0 0 4px #e4ca8e; }
    .renaissance-modal .modal-header { border-bottom-color: #b89a5d; background: linear-gradient(90deg,#ead5a4,#fff8e6); font-family: Georgia,"Times New Roman",serif; }
    .board-heading { margin: .75rem 0 .35rem; color: #553b14; font: 700 1.35rem Georgia,"Times New Roman",serif; letter-spacing: .04em; }
